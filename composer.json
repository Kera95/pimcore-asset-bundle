{
  "name": "tsf/pimcore-asset-bundle",
  "description": "Automatically sorts Pimcore assets referenced by DataObjects and Documents into configurable folder structures.",
  "type": "pimcore-bundle",
  "license": "MIT",
  "keywords": ["pimcore", "pimcore-bundle", "asset"],
  "require": {
    "php": ">=8.1 <8.6",
    "pimcore/pimcore": "^11.0 || ^12.0 || ^2026.1",
    "symfony/config": "^6.2 || ^7.3",
    "symfony/console": "^6.2 || ^7.3",
    "symfony/dependency-injection": "^6.2 || ^7.3",
    "symfony/http-kernel": "^6.2 || ^7.3"
  },
  "autoload": {
    "psr-4": {
      "Tsf\\AssetBundle\\": "src/"
    }
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Tsf\\AssetBundle\\TsfAssetBundle"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
